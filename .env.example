# Copy to .env. Never commit real values.
NODE_ENV=production
APP_ORIGIN=https://pact.example.com
# CORS_ORIGINS=https://staging.pact.example.com
TRUST_PROXY=true

# Postgres (managed Postgres in production; sslmode=require for hosted databases)
DATABASE_URL=postgres://user:password@host:5432/pact?sslmode=require
DB_POOL_MAX=10
# Optional: run migrations as the schema owner, serve traffic with a restricted role (server/src/db/roles.sql)
# MIGRATION_DATABASE_URL=postgres://pact_owner:password@host:5432/pact?sslmode=require

# Secrets: generate each with `openssl rand -base64 48`
JWT_SECRET=
HASH_SECRET=
# 32 bytes, base64: `openssl rand -base64 32`
DATA_ENCRYPTION_KEY=

# Which deployment this is. production = real money (live Paystack key, Termii SMS). staging = closed beta,
# sandbox payments only: see .env.staging.example and STAGING.md. The app refuses unsafe combinations.
DEPLOY_ENV=production

# Payments: paystack with an sk_live_ key in production. Sandbox payments are for staging only.
PAYMENTS_PROVIDER=paystack
PAYSTACK_SECRET_KEY=

# SMS for sign-in codes
SMS_PROVIDER=termii
TERMII_API_KEY=
TERMII_SENDER_ID=PACT

# Email for sign-in codes. Resend is the production provider; `log` (development only) prints codes instead of sending them.
EMAIL_PROVIDER=resend
RESEND_API_KEY=
EMAIL_FROM=PACT <login@your-domain.example>

# Google sign-in (OAuth 2.0 / OpenID Connect). Leave all three empty to switch it off; set ID and secret together.
# In production set GOOGLE_REDIRECT_URI explicitly to exactly the URI registered with Google:
#   https://YOUR-DOMAIN/api/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=

# Per-IP HTTP limits: postgres (shared by every instance, default) or memory (one process only)
# RATE_LIMIT_STORE=postgres

# Run jobs in the API process (true) or in a separate `npm run worker` (false)
RUN_WORKER=true
# Enables GET /api/ops/reconcile with `Authorization: Bearer <OPS_TOKEN>`
OPS_TOKEN=
LOG_LEVEL=info

# Browser push notifications (optional). Leave all three empty and push is simply unavailable; everything else works.
# Generate a pair once with:  npx web-push generate-vapid-keys   (keep the private key secret, never commit it).
# The subject is who push services can contact about this sender: mailto:you@example.com or an https URL.
WEB_PUSH_VAPID_PUBLIC_KEY=
WEB_PUSH_VAPID_PRIVATE_KEY=
WEB_PUSH_SUBJECT=
