{
  "name": "pact",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "concurrently -k -n api,web -c green,blue \"npm:dev:api\" \"npm:dev:web\"",
    "build": "tsc -b && vite build && npm run build:server",
    "preview": "vite preview",
    "typecheck": "tsc -b --noEmit && tsc -p server/tsconfig.json",
    "capture:site": "node scripts/capture.mjs exports/landing",
    "capture:app": "node scripts/capture-app.mjs exports/app",
    "snapshots": "npm run capture:app && python3 scripts/snapshots.py",
    "export:app": "HTML_OUT=exports/html node scripts/capture-app.mjs exports/app && python3 scripts/frame.py && python3 scripts/snapshots.py",
    "export:site": "HTML_OUT=exports/html node scripts/capture.mjs exports/landing",
    "export:zip": "python3 scripts/zip-index.py",
    "export": "npm run export:app && npm run export:site && npm run export:zip",
    "export:screens": "node scripts/export-screens.mjs",
    "dev:web": "vite",
    "dev:api": "PORT=8787 tsx watch --clear-screen=false server/src/index.ts",
    "build:server": "esbuild server/src/index.ts server/src/worker.ts --bundle --platform=node --format=esm --packages=external --outdir=build --out-extension:.js=.mjs && mkdir -p build/migrations && cp server/src/db/migrations/*.sql build/migrations/",
    "start": "NODE_ENV=production SERVE_STATIC=true node build/index.mjs",
    "worker": "NODE_ENV=production node build/worker.mjs",
    "test": "node --import tsx --test --test-concurrency=1 server/test/*.test.ts",
    "test:roles": "TEST_DB_ROLE=service node --import tsx --test --test-concurrency=1 server/test/*.test.ts",
    "db:reset": "rm -rf .data",
    "e2e": "node scripts/e2e.mjs"
  },
  "dependencies": {
    "@electric-sql/pglite": "^0.5.8",
    "@fastify/cookie": "^11.1.2",
    "@fastify/cors": "^11.3.0",
    "@fastify/helmet": "^13.1.1",
    "@fastify/rate-limit": "^11.2.0",
    "@fastify/static": "^10.1.4",
    "@fontsource-variable/geist": "^5.3.0",
    "@gsap/react": "^2.1.2",
    "@react-three/drei": "^9.122.0",
    "@react-three/fiber": "^8.18.0",
    "@tanstack/react-query": "^5.103.2",
    "fastify": "^5.12.5",
    "framer-motion": "^13.4.3",
    "gsap": "^3.15.0",
    "jose": "^6.2.12",
    "lucide-react": "^1.48.0",
    "pg": "^8.23.0",
    "pino": "^10.3.1",
    "qrcode": "^1.5.4",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^7.18.4",
    "sharp": "^0.35.4",
    "three": "^0.169.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/node": "^26.6.2",
    "@types/pg": "^8.23.1",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "@types/three": "^0.169.0",
    "@vitejs/plugin-react": "^4.7.0",
    "axe-core": "^4.13.0",
    "concurrently": "^10.0.5",
    "esbuild": "^0.21.5",
    "marked": "^12.0.2",
    "pino-pretty": "^13.1.3",
    "playwright": "^1.63.0",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vite": "^5.4.21"
  }
}
