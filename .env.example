# Copy to .env. Never commit real values.
NODE_ENV=production
APP_ORIGIN=https://pact.example.com
# CORS_ORIGINS=https://staging.pact.example.com
TRUST_PROXY=true

# Postgres (managed Postgres in production; sslmode=require for hosted databases)
DATABASE_URL=postgres://user:password@host:5432/pact?sslmode=require
DB_POOL_MAX=10
# Optional: run migrations as the schema owner, serve traffic with a restricted role (server/src/db/roles.sql)
# MIGRATION_DATABASE_URL=postgres://pact_owner:password@host:5432/pact?sslmode=require

# Secrets: generate each with `openssl rand -base64 48`
JWT_SECRET=
HASH_SECRET=
# 32 bytes, base64: `openssl rand -base64 32`
DATA_ENCRYPTION_KEY=

# Payments: paystack in production. sandbox is refused unless ALLOW_SANDBOX_IN_PRODUCTION=true (demo deploys).
PAYMENTS_PROVIDER=paystack
PAYSTACK_SECRET_KEY=
# ALLOW_SANDBOX_IN_PRODUCTION=false

# SMS for sign-in codes
SMS_PROVIDER=termii
TERMII_API_KEY=
TERMII_SENDER_ID=PACT

# Run jobs in the API process (true) or in a separate `npm run worker` (false)
RUN_WORKER=true
# Enables GET /api/ops/reconcile with `Authorization: Bearer <OPS_TOKEN>`
OPS_TOKEN=
LOG_LEVEL=info
